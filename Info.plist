<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict/>
		<dict/>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>weixin</string>
		<string>wechat</string>
		<string>xhsdiscover</string>
		<string>twitter</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>我们需要访问您的相机以拍摄宠物照片并生成证件照。</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>我们需要获取您的位置以展示附近的宠物友好地及提供导航引导。</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>我们需要访问您的麦克风以录制语音消息，发送给 AI 进行语音识别与对话。</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>我们需要将生成的宠物证件照保存到您的相册中。</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>我们需要访问您的相册以选取宠物照片进行档案维护。</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
